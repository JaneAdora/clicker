/target

# Runtime secrets: clicker writes the client cert/key and config (TV host, paired
# state) to ~/.config/clicker/, never the repo. Ignore them here too so a stray
# copy dropped in the working tree can never be committed by accident.
*.pem
*.key
config.toml
/.config/

# Android app build output and local config
android/.gradle/
android/**/build/
android/local.properties
android/app/src/main/jniLibs/
*.jks
*.keystore
.cxx/

# Local agent scratch (plans in progress, review packages).
.superpowers/
