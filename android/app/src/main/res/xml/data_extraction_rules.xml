<?xml version="1.0" encoding="utf-8"?>
<!-- The app stores the TV pairing key in filesDir. Keep it out of cloud backup
     and device-to-device transfer; allowBackup="false" alone does not cover
     device-to-device transfer on Android 12 and later. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
